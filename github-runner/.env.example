# Copy to .env and fill in.
# Repository URL the runner serves:
REPO_URL=https://github.com/YOUR_GITHUB_USER/visitor-counter-flask
# Registration token (valid for 1 hour):
#   repo -> Settings -> Actions -> Runners -> New self-hosted runner -> Linux
RUNNER_TOKEN=
RUNNER_NAME=ubuntu-vm-runner-1
# Comma-separated custom labels (self-hosted, linux, x64 are added automatically)
RUNNER_LABELS=deploy
# Host docker group ID:  getent group docker | cut -d: -f3
DOCKER_GID=
